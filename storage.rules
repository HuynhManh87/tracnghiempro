rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Admin document existence grants Super Admin.
    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isActiveOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/access/$(uid)).data.active == true;
    }

    match /teachers/{uid}/{allPaths=**} {
      allow read, write: if isAdmin() || isActiveOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
