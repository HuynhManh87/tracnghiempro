rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveCurrentUser() {
      return signedIn()
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true;
    }

    function isActiveTeacher(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/access/$(uid)).data.active == true;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /access/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{uid} {
      allow read: if isAdmin() || isActiveTeacher(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isActiveTeacher(uid);

      match /{document=**} {
        allow read, write: if isAdmin() || isActiveTeacher(uid);
      }
    }

    match /sharedAnswerPackages/{packageId} {
      allow read: if isAdmin() || isActiveCurrentUser();

      allow create: if isActiveCurrentUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.format == 'OMR_MOBILE_SHARED_ANSWER_KEY';

      allow update: if isAdmin()
        || (isActiveCurrentUser()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid);

      allow delete: if isAdmin()
        || (isActiveCurrentUser() && resource.data.ownerUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
